// Prisma schema for 省庁新着ダッシュボード
// SQLite for MVP, designed for easy migration to PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 新着アイテム（各省庁のRSS/新着から取得）
model Item {
  id           String   @id @default(uuid())
  ministry     String   // 省庁名（例：経済産業省）
  sourceName   String   @map("source_name") // RSS名（例：プレスリリース）
  title        String
  url          String   // 原文リンク（クリックで省庁サイトへ）
  publishedAt  DateTime @map("published_at") // 発表日時
  fetchedAt    DateTime @default(now()) @map("fetched_at") // 取得日時
  summaryRaw   String?  @map("summary_raw") // RSS内descriptionなど
  contentText  String?  @map("content_text") // 本文テキスト（取得できれば）
  hash         String   @unique // title+url+publishedAt から生成。重複排除用
  updatedFlag  Boolean  @default(false) @map("updated_flag") // 同一urlで内容変化
  dateEstimated Boolean @default(false) @map("date_estimated") // published_at が推定値の場合true

  // --- 将来拡張用 ---
  // category    String?  // カテゴリ自動付与
  // importance  Int?     // 重要度スコア (0-100)
  // diffText    String?  // 更新差分
  // notified    Boolean  @default(false) // 通知済みフラグ

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ministry])
  @@index([publishedAt])
  @@index([ministry, publishedAt])
  @@map("items")
}

/// RSSソース定義（将来DB管理に切り替え可能）
model Source {
  id         String   @id @default(uuid())
  ministry   String
  name       String   // プレスリリース、新着情報など
  url        String   // RSS/Atom URL
  type       String   @default("rss") // "rss" | "atom" | "scrape"
  enabled    Boolean  @default(true)
  lastFetchedAt DateTime? @map("last_fetched_at")
  lastError  String?  @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ministry, name])
  @@map("sources")
}

/// 日次要約キャッシュ
model DailySummary {
  id         String   @id @default(uuid())
  date       String   // "2026-02-13" 形式
  ministry   String?  // null = 全体要約、指定あり = 省庁別要約
  summary    String   // 箇条書きJSON or テキスト
  itemCount  Int      @map("item_count") // 生成時のアイテム数
  itemsHash  String   @map("items_hash") // アイテムのハッシュ（変更検知用）
  generatedAt DateTime @default(now()) @map("generated_at")

  // --- 将来拡張用 ---
  // model     String?  // 使用したLLMモデル名
  // promptVersion String? // プロンプトバージョン

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, ministry])
  @@index([date])
  @@map("daily_summaries")
}

/// 取得ログ（エラー耐性・デバッグ用）
model FetchLog {
  id         String   @id @default(uuid())
  ministry   String
  sourceName String   @map("source_name")
  sourceUrl  String   @map("source_url")
  status     String   // "success" | "error"
  itemCount  Int?     @map("item_count")
  error      String?
  duration   Int?     // ms
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@index([fetchedAt])
  @@map("fetch_logs")
}
